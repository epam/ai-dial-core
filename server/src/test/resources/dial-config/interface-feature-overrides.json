          "features": {"reasoning_efforts": ["low", "medium", "high", "xhigh", "max"]}
        }
      },
      "upstreams": [{"id": "upstream", "endpoint": "http://provider", "key": "test-key"}]
    },
    "feature-translator": {
      "type": "chat",
      "features": {"tools_supported": true, "temperature_supported": false, "reasoning_efforts": ["low"]},
