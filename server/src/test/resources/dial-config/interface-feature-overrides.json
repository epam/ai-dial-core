        "openaiEmbeddings": {"features": {"tools_supported": false, "reasoning_efforts": []}},
        "openaiResponses": {"features": {"tools_supported": false, "reasoning_efforts": []}},
        "anthropicMessages": {"features": {"tools_supported": false, "reasoning_efforts": []}}
      },
      "upstreams": [{"id": "upstream", "endpoint": "http://provider", "key": "test-key"}]
