{
  "globalInterceptors": ["i1"],
  "interceptors": {
    "i1": {
      "endpoint": "http://localhost:4848/openai/deployments/i1/chat/completions",
      "interfaces": {"openaiResponses": {"base_url": "http://localhost:4848/i1"}}
    }
  },
  "routers": {
    "r1": {
      "baseUrl": "http://localhost:4848",
      "mode": "decision",
      "interfaces": {"openaiChatCompletions": {}, "openaiResponses": {}}
    }
  },
  "models": {
    "gpt-4": {
      "type": "chat",
      "baseUrl": "http://localhost:4848",
      "interfaces": {"openaiChatCompletions": {}, "openaiResponses": {}}
    }
  },
  "aliases": {
    "alias-gpt": {
      "presentAs": "model",
      "target": {"path": "models/gpt-4"}
    }
  },
  "keys": {
    "proxyKey1": {"project": "p1", "role": "default"}
  }
}
