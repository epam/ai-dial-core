{
  "spendingLimits": {
    "mode": "enforce"
  },
  "models": {
    "claude-spend": {
      "type": "chat",
      "interfaces": {
        "anthropicMessages": {
          "base_url": "http://localhost:4848"
        }
      },
      "pricing": {
        "unit": "token",
        "prompt": "0.025",
        "completion": "0.025"
      }
    },
    "claude-other": {
      "type": "chat",
      "interfaces": {
        "anthropicMessages": {
          "base_url": "http://localhost:4848"
        }
      },
      "pricing": {
        "unit": "token",
        "prompt": "0.025",
        "completion": "0.025"
      }
    },
    "claude-burst": {
      "type": "chat",
      "interfaces": {
        "anthropicMessages": {
          "base_url": "http://localhost:4848"
        }
      },
      "pricing": {
        "unit": "token",
        "prompt": "0.025",
        "completion": "0.025"
      }
    },
    "claude-translated": {
      "type": "chat",
      "pricing": {
        "unit": "token",
        "prompt": "0.025",
        "completion": "0.025"
      },
      "interfaces": {
        "openaiChatCompletions": {
          "base_url": "http://localhost:4848"
        },
        "anthropicMessages": {
          "mode": "translator",
          "translator": {
            "out": "openaiChatCompletions",
            "baseUrl": "http://localhost:4848"
          }
        }
      }
    },
    "gpt-spend": {
      "type": "chat",
      "interfaces": {
        "openaiResponses": {
          "base_url": "http://localhost:4848"
        }
      },
      "pricing": {
        "unit": "token",
        "prompt": "0.025",
        "completion": "0.025"
      }
    },
    "gpt-other": {
      "type": "chat",
      "interfaces": {
        "openaiResponses": {
          "base_url": "http://localhost:4848"
        }
      },
      "pricing": {
        "unit": "token",
        "prompt": "0.025",
        "completion": "0.025"
      }
    },
    "gpt-translated": {
      "type": "chat",
      "pricing": {
        "unit": "token",
        "prompt": "0.025",
        "completion": "0.025"
      },
      "interfaces": {
        "openaiChatCompletions": {
          "base_url": "http://localhost:4848"
        },
        "openaiResponses": {
          "mode": "translator",
          "translator": {
            "out": "openaiChatCompletions",
            "baseUrl": "http://localhost:4848"
          }
        }
      }
    },
    "m1": {
      "type": "chat",
      "interfaces": {
        "anthropicMessages": {
          "base_url": "http://localhost:4848"
        },
        "openaiResponses": {
          "base_url": "http://localhost:4848"
        }
      },
      "pricing": {
        "unit": "token",
        "prompt": "0.025",
        "completion": "0.025"
      }
    },
    "m-icpt": {
      "type": "chat",
      "interceptors": ["icpt"],
      "interfaces": {
        "openaiResponses": {
          "base_url": "http://localhost:4848"
        }
      },
      "pricing": {
        "unit": "token",
        "prompt": "0.025",
        "completion": "0.025"
      }
    }
  },
  "interceptors": {
    "icpt": {
      "endpoint": "http://localhost:4848/openai/deployments/icpt/chat/completions",
      "interfaces": {"openaiResponses": {"base_url": "http://localhost:4848/icpt"}}
    }
  },
  "routers": {
    "r1": {
      "baseUrl": "http://localhost:4848",
      "mode": "decision",
      "interfaces": {
        "anthropicMessages": {},
        "openaiResponses": {}
      }
    }
  },
  "aliases": {
    "alias-m1": {
      "presentAs": "model",
      "target": {"path": "models/m1"}
    },
    "strong": {
      "presentAs": "model",
      "target": {"path": "routers/r1"}
    },
    "alias-icpt": {
      "presentAs": "model",
      "target": {"path": "models/m-icpt"}
    }
  },
  "applications": {
    "app-chain": {
      "endpoint": "http://localhost:4848/openai/deployments/app-chain/chat/completions"
    },
    "app-claude": {
      "interfaces": {
        "anthropicMessages": {
          "base_url": "http://localhost:4848"
        }
      }
    },
    "app-responses": {
      "interfaces": {
        "openaiResponses": {
          "base_url": "http://localhost:4848"
        }
      }
    }
  },
  "keys": {
    "proxyKey1": {
      "project": "spend",
      "role": "user"
    }
  },
  "roles": {
    "user": {
      "limits": {
        "claude-spend": {},
        "claude-other": {},
        "claude-burst": {
          "minute": "10"
        },
        "claude-translated": {},
        "gpt-spend": {},
        "gpt-other": {},
        "gpt-translated": {},
        "app-chain": {},
        "app-claude": {},
        "app-responses": {},
        "m1": {},
        "m-icpt": {},
        "alias-icpt": {},
        "alias-m1": {
          "requestDay": 1
        }
      },
      "costLimit": {
        "day": "10",
        "month": "100"
      }
    },
    "default": {
      "limits": {}
    }
  }
}
