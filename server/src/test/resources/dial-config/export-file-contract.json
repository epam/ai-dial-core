{
  "models": {
    "file-model": {
      "type": "chat",
      "endpoint": "http://file-model.invalid/v1/chat/completions",
      "upstreams": [
        {
          "endpoint": "http://file-model.invalid",
          "key": "FILE-MODEL-KEY"
        }
      ]
    },
    "shared-model": {
      "type": "chat",
      "endpoint": "http://file-shared.invalid/v1/chat/completions"
    }
  },
  "interceptors": {
    "file-interceptor": {
      "endpoint": "http://file-interceptor.invalid/handle"
    }
  },
  "toolsets": {
    "file-toolset": {
      "endpoint": "http://file-toolset.invalid/mcp",
      "transport": "HTTP",
      "auth_settings": {
        "authentication_type": "OAUTH",
        "client_id": "c",
        "client_secret": "FILE-TOOLSET-SECRET",
        "code_verifier": "FILE-VERIFIER-SECRET",
        "token_endpoint": "https://a.invalid/t"
      }
    }
  },
  "applications": {
    "file-app": {
      "endpoint": "http://file-app.invalid/chat",
      "dependencies": ["file-model"]
    }
  },
  "applicationTypeSchemas": [
    {
      "$schema": "https://dial.epam.com/application_type_schemas/schema#",
      "$id": "https://dial.example/custom_application_schemas/file_schema",
      "dial:applicationTypeEditorUrl": "https://dial.example/custom_application_schemas/editor",
      "dial:applicationTypeViewerUrl": "https://dial.example/custom_application_schemas/viewer",
      "dial:applicationTypeDisplayName": "File Application Type",
      "dial:applicationTypeCompletionEndpoint": "http://specific_application_service/openai/v1/completion"
    }
  ],
  "keys": {"proxyKey1": {"project": "test", "role": "default"}}
}
