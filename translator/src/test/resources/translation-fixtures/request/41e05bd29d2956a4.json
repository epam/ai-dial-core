{
  "features": [
    "field:max_tokens",
    "field:messages"
  ],
  "input": {
    "for_count_tokens": false,
    "model": "gpt-5.5",
    "request": {
      "max_tokens": 100,
      "messages": [
        {
          "content": "first",
          "role": "user"
        },
        {
          "clear_at": "next_user_message",
          "content": "only for the first turn",
          "role": "system"
        },
        {
          "content": "ok",
          "role": "assistant"
        },
        {
          "content": "second",
          "role": "user"
        }
      ]
    },
    "tool_names": null
  },
  "kind": "request",
  "output": {
    "body": {
      "include": [
        "reasoning.encrypted_content"
      ],
      "input": [
        {
          "content": [
            {
              "text": "first",
              "type": "input_text"
            }
          ],
          "role": "user",
          "type": "message"
        },
        {
          "content": "ok",
          "role": "assistant",
          "type": "message"
        },
        {
          "content": [
            {
              "text": "second",
              "type": "input_text"
            }
          ],
          "role": "user",
          "type": "message"
        }
      ],
      "max_output_tokens": 100,
      "model": "gpt-5.5",
      "store": false
    },
    "tool_names": null
  },
  "tests": [
    "tests/test_to_responses.py::test_an_expired_system_message_is_not_sent"
  ]
}
